# Database when run with plain Python (python main.py): a file, nothing to install
DATABASE_URL=sqlite+aiosqlite:///data/leadhunter.db
# Database when run with Docker Compose: its own Postgres, these are its login
POSTGRES_USER=leadhunter
POSTGRES_PASSWORD=leadhunter
POSTGRES_DB=leadhunter
POSTGRES_PORT=5432

# Telegram bot (required): token from @BotFather, your ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only if Telegram is blocked: socks5://host:port or http://host:port
TELEGRAM_PROXY_URL=

# The AI provider, key and model are set in Telegram with /connect, not here.

# Scoring: minimum score to draft, score sent immediately, digest times
SCORE_THRESHOLD=6
URGENT_SCORE=9
DIGEST_TIMES=09:00,18:00
# Ignore posts older than this
MAX_LEAD_AGE_HOURS=48
# How often leads are scored, and how many per run
SCORE_INTERVAL_MINUTES=5
SCORE_BATCH_SIZE=20
DRAFT_BATCH_SIZE=10

# Sources to run (one without its keys is skipped)
COLLECTORS=remoteok,weworkremotely,hackernews,reddit,upwork,telegram,discord
# Remote OK tags to keep
REMOTEOK_TAGS=dev,full stack,javascript,typescript,react,node,python,backend,front end
# We Work Remotely feeds
WWR_FEEDS=https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss
# Hacker News "Who is hiring": words a post must mention
HN_KEYWORDS=contract,contractor,freelance,freelancer,part-time,consulting,consultant,fractional

# Reddit: "script" app from reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linux:leadhunter:0.1 (by /u/your_username)
REDDIT_SUBREDDITS=forhire,slavelabour,jobbit,remotejs

# Upwork alert emails read from your inbox (Gmail: imap.gmail.com + app password)
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
UPWORK_SENDER=upwork.com

# Telegram job channels: API ID and hash from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Printed by: python -m leadhunter.telegram_login
TELEGRAM_SESSION=
# Channel usernames without @
TELEGRAM_CHANNELS=

# Discord: bot token and channel IDs to listen in
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# Email for sending approved proposals (optional; Gmail: smtp.gmail.com + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# General
TIMEZONE=Asia/Karachi
PROFILE_PATH=profile.yaml
LOG_LEVEL=INFO
LOG_FORMAT=json
